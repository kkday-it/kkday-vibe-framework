# ==========================================
# [Runtime Plain] 不敏感的執行期參數
# ==========================================
# HTTP service port. EKS injects PORT; local default is 8080.
PORT=8080
VIBE_RUN_MODE=local

# ctx.storage adapter：local(預設,開發用寫 /tmp)| s3(雲上)
STORAGE_PROVIDER=local
# local 專用:暫存路徑(重啟即失、多 pod 不共享,勿當持久儲存)
VIBE_STORAGE_PATH=/tmp/vibe_storage
# s3 專用(STORAGE_PROVIDER=s3 時必填 S3_BUCKET;憑證走預設鏈,不填 AWS key)
S3_BUCKET=
# AWS_REGION=ap-northeast-1
# S3_PREFIX=

# ==========================================
# [Runtime Secret] 敏感憑證 (正式環境由 Vault/EKS Secrets 注入)
# ==========================================
# (Required) 用於 CronJob 觸發排程的驗證 Token
CRON_SECRET=

# (Required if DB) PostgreSQL 連線參數
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# 或直接用 DATABASE_URL (優先於上面的分項設定)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# (Optional) Slack Webhook URL 供 ctx.notify 使用
SLACK_WEBHOOK_URL=

# ==========================================
# [Build-time Public] 構建期參數 (可寫死在 Git 或 Dockerfile)
# ==========================================
# NODE_ENV=development
